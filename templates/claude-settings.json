{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "GitCommit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/hooks/pre-commit-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/hooks/block-no-verify-hook.sh"
          }
        ]
      }
    ]
  }
}
